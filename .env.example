# === Telegram ===
TELEGRAM_BOT_TOKEN=

# === Access control ===
PUBLIC_ACCESS_ENABLED=true
# Existing operator/tester IDs; keep these for private reports and quota exemptions.
# When PUBLIC_ACCESS_ENABLED=false, only these IDs can use the bot (empty denies all).
ALLOWED_TELEGRAM_USER_IDS=

# === OpenRouter (transcript analysis only) ===
OPENROUTER_API_KEY=
# Cheap text model for picking interesting moments. Free-tier friendly.
CLIP_ANALYSIS_MODEL=google/gemini-2.5-flash

# === Whisper STT (faster-whisper) ===
# Model sizes: tiny | base | small | medium | large-v3
# small is the sweet spot for Russian on CPU.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ru

# === Database ===
DATABASE_URL=

# === Telegram transport (optional) ===
WEBHOOK_SECRET=
RAILWAY_PUBLIC_DOMAIN=
WEBHOOK_PATH=/webhook
PORT=8080

# === Video limits ===
# 10 min keeps audio.wav under 20 MB and Whisper 'small' int8 (~400 MB)
# fits within Railway 512 MB without OOM. Increase only on plans
# with 1+ GB RAM.
MAX_VIDEO_SIZE_MB=500
MAX_VIDEO_DURATION_MINUTES=10
DEFAULT_CLIP_COUNT=3
MAX_CLIP_COUNT=5
MAX_CONCURRENT_JOBS=1
CLIP_MIN_SECONDS=20
CLIP_MAX_SECONDS=60
CLIP_START_PADDING_SECONDS=0.5
CLIP_END_PADDING_SECONDS=0.5

# === Output format ===
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
OUTPUT_FPS=30
OUTPUT_VIDEO_BITRATE=4M
OUTPUT_AUDIO_BITRATE=128k

# === CTA overlay ===
CTA_ENABLED=false
CTA_ASSET_PATH=
CTA_MODE=end
CTA_POSITION=bottom
CTA_START_SECONDS=0
CTA_DURATION_SECONDS=4
CTA_MIN_MARGIN_PX=120

# === Subtitle safe areas (px) ===
SUBTITLE_SAFE_TOP_PX=300
SUBTITLE_SAFE_BOTTOM_PX=520
SUBTITLE_SAFE_LEFT_PX=80
SUBTITLE_SAFE_RIGHT_PX=80
SUBTITLE_MAX_WORDS_PER_LINE=4

# === Storage / cleanup ===
TEMP_DIR=/tmp/recut
JOB_TTL_MINUTES=120

# === App ===
LOG_LEVEL=INFO
ENVIRONMENT=production
# Dormant Telegram Stars preparation. Do not enable before launch checks in docs/PAYMENTS.md.
PAYMENTS_ENABLED=false
PAYMENT_PRICE_STARS=0
PAYMENT_CREDITS=0
PAYMENT_TERMS=
PAYMENT_SUPPORT=@stewchop
PAYMENT_ADMIN_IDS=

# Launch allowances (access allowlist remains separate)
REFERRALS_ENABLED=true
REFERRAL_REWARD_CREDITS=3
REFERRAL_MAX_REWARDS=50
GENERATION_LIMITS_ENABLED=true
DAILY_FREE_GENERATIONS=3
BETA_TESTERS_UNLIMITED=true
UNLIMITED_TELEGRAM_IDS=

# Private analytics operators; empty uses existing closed-beta allowlist
ADMIN_TELEGRAM_IDS=
TESTER_TELEGRAM_IDS=
