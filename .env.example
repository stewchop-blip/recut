# Telegram
TELEGRAM_BOT_TOKEN=

# OpenRouter (dedicated key for Recut)
OPENROUTER_API_KEY=
OPENROUTER_TTS_MODEL=openai/tts-1
OPENROUTER_REWRITE_MODEL=anthropic/claude-3-haiku

# Database (Railway PostgreSQL)
DATABASE_URL=

# Webhook (Railway)
WEBHOOK_SECRET=
RAILWAY_PUBLIC_DOMAIN=
WEBHOOK_PATH=/webhook

# Limits (configurable)
MAX_TEXT_LENGTH=4000
MAX_GENERATIONS_PER_DAY=20
TTS_TIMEOUT_SECONDS=30
REWRITE_TIMEOUT_SECONDS=20

# App
LOG_LEVEL=INFO
ENVIRONMENT=development
PORT=8080