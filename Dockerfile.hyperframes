# Recut — Python 3.12 slim with FFmpeg (future video features)
# Optional pilot image only. Railway continues to use the standard Dockerfile.
# Pinned HyperFrames package and system Chromium, no installs per request.
FROM node:22-bookworm-slim AS youtube-js
RUN npm install -g hyperframes@0.8.174 --no-audit --no-fund
FROM python:3.12-slim

# yt-dlp EJS needs an external JS runtime; npm is not needed at runtime.
COPY --from=youtube-js /usr/local/bin/node /usr/local/bin/node
COPY --from=youtube-js /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/hyperframes/bin/hyperframes.mjs /usr/local/bin/hyperframes
RUN node --version && hyperframes --version

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    fonts-dejavu-core \
    chromium \
    ffmpeg \
    gcc \
    libc-dev \
    libavcodec-dev \
    libavformat-dev \
    libavutil-dev \
    libswscale-dev \
    libswresample-dev \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -s /bin/bash recut && mkdir -p /tmp/recut && chown recut:recut /tmp/recut

WORKDIR /app

# Copy only dependencies first for layer caching
COPY pyproject.toml .
RUN pip install --no-cache-dir -e .
RUN python -c "import yt_dlp, yt_dlp_ejs, curl_cffi"

# Copy source
COPY app/ ./app/

# Environment
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    LOG_LEVEL=INFO \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
    HYPERFRAMES_BROWSER_PATH=/usr/bin/chromium \
    HYPERFRAMES_NO_TELEMETRY=1 \
    DO_NOT_TRACK=1 \
    PRODUCER_LOW_MEMORY_MODE=1 \
    HYPERFRAMES_NO_UPDATE_CHECK=1

USER recut

# Railway injects PORT; bind to all interfaces
EXPOSE 8080

# Health endpoint for Railway
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8080/healthz || exit 1

CMD ["python", "-m", "app.main"]
